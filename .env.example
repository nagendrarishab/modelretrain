#(get one at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# AWS credentials for the dvc-modeltrain IAM user (s3remote, s3://amzn-s3-dvc/dvcstore).
# Reference only — `dvc push`/`dvc pull` read from ~/.aws/credentials or real
# shell-exported env vars, not from this file, unless you export these yourself
# first, e.g.: set -a && source .env && set +a
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1